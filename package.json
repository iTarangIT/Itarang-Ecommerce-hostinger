{
  "name": "itarang-storefront",
  "version": "0.1.0",
  "private": true,
  "description": "iTarang Products storefront - home inverters, batteries, UPS systems and combos.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "gen:images": "node scripts/generate-product-art.mjs",
    "db": "node --env-file-if-exists=.env.local scripts/db.mts",
    "db:status": "npm run db -- status",
    "db:create": "npm run db -- create",
    "db:migrate": "npm run db -- migrate",
    "db:seed": "npm run db -- seed",
    "db:reset": "npm run db -- reset",
    "db:sweep": "npm run db -- sweep",
    "admin:create": "node --env-file-if-exists=.env.local scripts/admin-create.mts",
    "hostinger:probe": "node --env-file-if-exists=.env.local scripts/hostinger-probe.mts",
    "products:import": "node --env-file-if-exists=.env.local scripts/import-products.mts",
    "products:media": "node --env-file-if-exists=.env.local scripts/upload-product-media.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run test"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^15.5.4",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}
