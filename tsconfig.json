{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    // `scripts/db.mts` is executed by Node directly, whose ESM resolver needs a
    // real file extension. Modules shared between the app and those scripts
    // therefore import with `.ts`. Safe here because nothing is ever emitted.
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "noUncheckedIndexedAccess": false,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-prod/types/**/*.ts"
  ],
  // `.next-*` is a verification build made with NEXT_DIST_DIR (see the distDir
  // note in next.config.mjs). Excluded because `**/*.ts` above would otherwise
  // pull in a second copy of the generated route types, duplicating every
  // declaration `.next/types` already provides.
  "exclude": [
    "node_modules",
    ".next-*"
  ]
}
